{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "css-sota-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Workers Builds uploads a version for every push to a pull-request branch,
  // and each version is reachable at
  // <VERSION_PREFIX>-css-sota-mcp.lusrodri.workers.dev — so a PR can be tried
  // in the AI Playground or the Inspector before it merges.
  //
  // Stated explicitly rather than relied on: Cloudflare made preview URLs
  // opt-in in September 2025, and Wrangler 4.34+ defaults this to false. They
  // work here today by inheritance, which is one tool upgrade away from
  // silently going missing.
  //
  // Safe to expose because every version is the same read-only public server —
  // there is no staging data or unreleased secret behind these URLs.
  "preview_urls": true,
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      // 120 requests per minute per client IP, per Cloudflare location.
      //
      // Sized against real usage rather than a round number: an agent working
      // through a task calls a handful of tools per turn, so single-digit
      // requests per minute is typical and a burst of twenty is unremarkable.
      // 120 leaves room for a shared NAT address running several such clients
      // while still stopping a script in a loop.
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "SERVER_VERSION": "0.1.0"
  }
}
